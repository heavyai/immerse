{
  "name": "immerse",
  "version": "9.0.0",
  "description": "Immerse web visualization client",
  "main": "index.js",
  "scripts": {
    "build:dev": "bash scripts/build-dev.sh",
    "build:prod": "bash scripts/build-prod.sh",
    "build:prod:sourcemaps": "bash scripts/build-prod-sourcemaps.sh",
    "clean": "bash scripts/clean.sh",
    "mkDistDir": "mkdir ./dist",
    "deploy": "bash scripts/deploy.sh",
    "copyFavicon": "rsync --update ./src/favicon.ico ./dist/",
    "copyGeoJson": "rsync -r --update ./src/charts/geojson ./dist/",
    "copyServersJson": "rsync --update ./src/servers.json ./dist/",
    "copyServersLocalJson": "rsync --update src/servers.local.json ./dist/servers.json",
    "copyAppConfigJs": "rsync --update ./src/app-config.js ./dist/",
    "copyFonts": "rsync -r --update ./src/assets/fonts ./dist/",
    "copySamlErrorPage": "rsync -r --update ./src/assets/saml-error/ ./dist/",
    "lint": "npm run lint:cmd -- . --cache --ext=js --ext=jsx --ext=ts --ext=tsx",
    "lint:cmd": "NODE_OPTIONS=--max_old_space_size=4096 eslint",
    "lint:fix": "npm run lint -- --fix",
    "s:add": "bash scripts/servers/add.sh",
    "s:list": "bash scripts/servers/list.sh",
    "s:remove": "bash scripts/servers/remove.sh",
    "s:switch": "bash scripts/servers/switch.sh",
    "start": "ENABLE_CONTROL_PANEL=true npm run webpack:dev-server -- --open --hot --color",
    "start:ssl": "ENABLE_CONTROL_PANEL=true npm run webpack:dev-server -- --open --hot --color --https",
    "start:fast": "ENABLE_CONTROL_PANEL=true IMMERSE_BUILD_MODE=fast npm run webpack:dev-server -- --hot",
    "start:fast:ssl": "ENABLE_CONTROL_PANEL=true IMMERSE_BUILD_MODE=fast npm run webpack:dev-server -- --open --hot --https --cert=cert.pem --key=key.pem",
    "start:prod": "npm run build:prod && http-server ./dist -p \"${IMMERSE_PORT:-8002}\" -o -P \"http://localhost:${IMMERSE_PORT:-8002}?\"",
    "start:eco": "ENABLE_CONTROL_PANEL=true HEAVY_ECO=true npm run webpack:dev-server -- --open --hot --color",
    "test": "npm run lint && npm run test:unit && npm run test:component",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:debug": "DEBUG=true jest -t [Dd][Ee][Bb][Uu][Gg]",
    "test:coverage": "jest --coverage",
    "test:coverage:report": "npm run test:coverage && http-server ./coverage_jest",
    "test:unit": "jest '\\.unit\\.test\\.(t|j)sx?$'",
    "test:unit:debug": "jest '\\.unit\\.test\\.(t|j)sx?$' -t [Dd][Ee][Bb][Uu][Gg]",
    "test:component": "jest '\\.component\\.test\\.(t|j)sx?$' --runInBand",
    "test:component:debug": "jest '\\.component\\.test\\.(t|j)sx?$' -t [Dd][Ee][Bb][Uu][Gg]",
    "test:ui:single": "DEBUG=true jest --runInBand",
    "test:ui": "jest --runInBand --testPathIgnorePatterns='playwright' --testPathPatterns='\\.ui\\.test\\.(t|j)s$' ",
    "test:ui:observe": "DEBUG=true jest --runInBand --testPathIgnorePatterns='playwright' --testPathPatterns='\\.ui\\.test\\.(t|j)s$'",
    "test:ui:debug": "DEBUG=true jest --runInBand '\\.ui\\.test\\.(t|j)s$' -t [Dd][Ee][Bb][Uu][Gg]",
    "test:playwright": "npx playwright test",
    "test:playwright:gui": "npm run test:playwright -- --ui",
    "ts": "tsc",
    "webpack": "webpack",
    "webpack:dev-server": "NODE_OPTIONS=--max_old_space_size=4096 NODE_ENV=development PORT=\"${IMMERSE_PORT:-8002}\" webpack serve --config webpack.config.dev.ts",
    "checkLinked": "find node_modules -maxdepth 2 -type l -not -path \"node_modules/.bin/*\"",
    "listAvailableLinked": "npm ls -g --depth=0 --link=true"
  },
  "husky": {
    "hooks": {
      "pre-commit": "bash -c \"./githooks/pre-commit-check-tether-version.sh && ./githooks/pre-commit-lint.sh\"",
      "prepare-commit-msg": "bash -c \"./githooks/prepare-commit-msg-add-jira-id.sh $HUSKY_GIT_PARAMS\""
    }
  },
